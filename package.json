{
  "name": "matterbridge-plugin-tcl-home",
  "version": "1.0.5",
  "description": "Unofficial Matterbridge plugin for TCL Home Breeva air purifiers",
  "keywords": [
    "air-purifier",
    "air-quality",
    "breeva",
    "home-automation",
    "matter",
    "matter-protocol",
    "matterbridge",
    "matterbridge-plugin",
    "smart-home",
    "tcl",
    "tcl-home"
  ],
  "homepage": "https://github.com/MCKanpolat/matterbridge-plugin-tcl-home",
  "bugs": {
    "url": "https://github.com/MCKanpolat/matterbridge-plugin-tcl-home/issues"
  },
  "license": "Apache-2.0",
  "author": "MCKanpolat",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MCKanpolat/matterbridge-plugin-tcl-home.git"
  },
  "files": [
    "dist",
    "README.md",
    "matterbridge-plugin-tcl-home.config.json",
    "matterbridge-plugin-tcl-home.schema.json"
  ],
  "type": "module",
  "main": "dist/module.js",
  "types": "dist/module.d.ts",
  "exports": {
    ".": {
      "import": "./dist/module.js",
      "types": "./dist/module.d.ts"
    }
  },
  "scripts": {
    "start": "matterbridge",
    "add": "matterbridge --add .",
    "remove": "matterbridge --remove .",
    "enable": "matterbridge --enable .",
    "disable": "matterbridge --disable .",
    "link": "npm link --no-fund --no-audit matterbridge",
    "unlink": "npm unlink matterbridge",
    "build": "tsc --project tsconfig.build.json",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "lint": "oxlint --disable-nested-config src",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "vitest run",
    "live-test:breeva-a2": "npm run build && node live-tests/live-test-breeva-a2.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-iot-data-plane": "^3.1101.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "oxfmt": "^0.60.0",
    "oxlint": "^1.75.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "matterbridge": ">=3.10.0",
    "node": ">=20.19.0"
  }
}
